# Backend API origin (no trailing /api). Leave unset in Vite dev to use the
# /api proxy → http://127.0.0.1:8000 from vite.config.ts.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Dev only (`npm run dev`): shows a "Fill Demo Admin" button on the login page. Never read in
# production builds. Put real values in .env.development.local, not here.
# VITE_DEMO_ADMIN_EMAIL=
# VITE_DEMO_ADMIN_PASSWORD=
